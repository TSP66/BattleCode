# environments
.venv*/
__pycache__/
*.pyc
.ipynb_checkpoints/

# built artifacts (make -C bcsim)
*.so
*.so.tmp
.unswbc-build/

# training output: everything under runs/ except the fixed eval opponents
runs/*
!runs/anchors/
!runs/submitted/
# Scraped games (raw .replay + .json) are NOT tracked: re-fetch them with
# train.replay_fetch, and rebuild the per-game datasets with
# train.replay_dataset (see DISTILL.md). 16 GB on disk here.
#
# History note: replays for ten teams WERE tracked and are still in origin's
# history up to 7e98ef48; recover them with
#     git checkout 7e98ef48 -- runs/replays
# A later scrape added 18,778 more files and GitHub refused the push
# ("remote unpack failed: index-pack failed"), so tracking them was dropped.
runs/replays/
# the 8 live maps every eval, clone and fine-tune uses
!runs/ft3/
runs/ft3/*
!runs/ft3/maps/
# fine-tune history (why each run exists) and the best RL policy (ft6 113M)
!runs/ft[0-9]/
runs/ft[0-9]/*
!runs/ft[0-9]/CHANGES.md
!runs/ft6/snapshots/
runs/ft6/snapshots/*
!runs/ft6/snapshots/turns_112721920.pt
# behaviour clones: the chosen checkpoint and the training curve only
!runs/imitate_*/
runs/imitate_*/*
!runs/imitate_*/best.pt
!runs/imitate_*/log.jsonl
# replay-pretrained team critic. Every extract it writes is derived and huge, so
# ignore them by prefix rather than one at a time -- `data_board/` (8 GB) slipped
# through a rule that named only `data/` and was committed by accident.
!runs/team_critic/
runs/team_critic/data*/
runs/team_critic/*.out
# small result files
!runs/server_tests/
!runs/critic_probe/
!runs/clone_compare*/
runs/clone_compare*/*.pt
ckpt/

# regenerated by bcsim/train/export_cpp.py (8 MB, changes on every export)
mybot/weights_data.hpp
*.bin

# archive: code only, not its data blobs or map copies
archive/**/*.npz
archive/**/*.dat
archive/probe/maps/
runs/critic_probe/data/

# derived replay labels (train.super_sprint, train.self_trap): rebuilt in minutes
runs/replays/*/sprint/
runs/replays/*/selftrap/
.DS_Store

# the clones and game results behind DISTILL_DEVTEST.md
!runs/i2/
runs/i2/*
!runs/i2/*/
runs/i2/*/*
!runs/i2/*/log.jsonl
!runs/i2/full_mem_memfar/best.pt
# league members for the 2026-09-23 restart, so a fresh clone can run it
!runs/i2/devtest_2050/best.pt
!runs/i2/sponge_2110/best.pt
!runs/evals/
runs/evals/*.pt

# derived: maps/ + maps-gen/ in one directory, because build_pool takes one dir
#   mkdir -p maps-all && cp maps/*.map maps-gen/*.map maps-all/
maps-all/
