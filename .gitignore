# environments
.venv*/
__pycache__/
*.pyc
.ipynb_checkpoints/

# built artifacts (make -C bcsim)
*.so
*.so.tmp
.unswbc-build/

# training output: everything under runs/ except the fixed eval opponents
runs/*
!runs/anchors/
!runs/submitted/
# scraped games (raw .replay + .json). The per-game datasets are derived and
# large (6 GB): rebuild them with train.replay_dataset (see DISTILL.md)
!runs/replays/
runs/replays/*/dataset/
# the 8 live maps every eval, clone and fine-tune uses
!runs/ft3/
runs/ft3/*
!runs/ft3/maps/
# fine-tune history (why each run exists) and the best RL policy (ft6 113M)
!runs/ft[0-9]/
runs/ft[0-9]/*
!runs/ft[0-9]/CHANGES.md
!runs/ft6/snapshots/
runs/ft6/snapshots/*
!runs/ft6/snapshots/turns_112721920.pt
# behaviour clones: the chosen checkpoint and the training curve only
!runs/imitate_*/
runs/imitate_*/*
!runs/imitate_*/best.pt
!runs/imitate_*/log.jsonl
# replay-pretrained team critic (its 4.9 GB extract is rebuilt by team_critic extract)
!runs/team_critic/
runs/team_critic/data/
# small result files
!runs/server_tests/
!runs/critic_probe/
!runs/clone_compare*/
runs/clone_compare*/*.pt
ckpt/

# regenerated by bcsim/train/export_cpp.py (8 MB, changes on every export)
mybot/weights_data.hpp
*.bin

# archive: code only, not its data blobs or map copies
archive/**/*.npz
archive/**/*.dat
archive/probe/maps/
runs/critic_probe/data/
